---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Timeline from '../components/Timeline.astro';
import ContactForm from '../components/ContactForm.astro';
import { projects } from '../data/projects';
import { experience } from '../data/experience';
import { certifications } from '../data/certifications';
import { skillGroups } from '../data/skills';
import { soldProducts } from '../data/soldProducts';
import Badge from '../components/Badge.astro';
import SoldProductCard from '../components/SoldProductCard.astro';
import TechChip from '../components/TechChip.astro';
import HomePage from '../components/HomePage.astro';
import { getCopy, type Locale, type PageId, localizeCertifications } from '../i18n/localization';

type Props = { locale: Locale; pageId: PageId };
const { locale, pageId } = Astro.props;
const copy = getCopy(locale);
const english = locale === 'en';
const labels = english
	? { title: { home: 'Portfolio', projects: 'Projects', experience: 'Experience', about: 'About me', certifications: 'Certifications', contact: 'Contact' }[pageId], intro: 'I build fast, accessible, and maintainable web products.', form: 'Send me a message', success: 'Message received. Thank you!' }
	: { title: { home: 'Inicio', projects: 'Proyectos', experience: 'Experiencia', about: 'Acerca de mí', certifications: 'Certificaciones', contact: 'Contacto' }[pageId], intro: 'Construyo productos web rápidos, accesibles y mantenibles.', form: 'Envíame un mensaje', success: 'Mensaje recibido. ¡Gracias!' };
const sent = pageId === 'contact' && Astro.url.searchParams.get('enviado') === '1';
---

<BaseLayout title={labels.title} locale={locale} pageId={pageId}>
	{pageId === 'home' ? (
			<HomePage locale={locale} />
	) : pageId === 'projects' ? (
		<><Section title={copy.nav.projects}><div class="grid">{projects.map((project) => <ProjectCard project={project} locale={locale} />)}</div></Section><Section title={english ? 'Commercial products' : 'Productos comerciales'}><div class="grid">{soldProducts.map((product) => <SoldProductCard product={product} locale={locale} />)}</div></Section></>
	) : pageId === 'experience' ? (
		<Section title={english ? 'Professional experience' : 'Experiencia laboral'}><Timeline items={experience} locale={locale} /></Section>
	) : pageId === 'contact' ? (
		<Section title={copy.nav.contact} subtitle={english ? 'Tell me about your project.' : 'Cuéntame sobre tu proyecto.'}>{sent ? <div role="status">{labels.success}</div> : null}<div class="card panel"><h2>{labels.form}</h2><ContactForm locale={locale} subjectTag="portfolio" /></div></Section>
	) : pageId === 'certifications' ? (
				<Section title={copy.nav.certifications}><div class="grid">{localizeCertifications(locale, certifications).map((certification) => <Badge label={certification.badgeLabel} title={certification.name} subtitle={`${certification.issuer} · ${certification.year}`} href={certification.url} imageSrc={certification.image} imageAlt={certification.imageAlt} />)}</div></Section>
	) : (
		<Section title={labels.title} subtitle={english ? 'Professional profile and technical skills.' : 'Perfil profesional y habilidades técnicas.'}><div class="card panel"><h2>{english ? 'Profile' : 'Perfil'}</h2><p class="muted">{english ? 'I develop web products with a focus on performance, clarity, and simple architecture.' : 'Desarrollo productos web con foco en rendimiento, claridad y arquitectura simple.'}</p><h2>{english ? 'Skills' : 'Habilidades'}</h2>{skillGroups.map((group) => <div><h3>{locale === 'en' && group.title === 'Backend / Infra' ? 'Backend / Infrastructure' : group.title}</h3><ul>{group.items.map((item) => <li><TechChip label={item} /></li>)}</ul></div>)}</div></Section>
	)}
</BaseLayout>
