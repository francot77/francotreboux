---
type Props = {
	title: string;
	subtitle?: string;
	id?: string;
};

const { title, subtitle, id } = Astro.props;
---

<section class="section" id={id} data-reveal>
	<div class="container">
		<header class="heading">
			<h2 class="title">{title}</h2>
			{subtitle ? <p class="subtitle muted">{subtitle}</p> : null}
		</header>
		<div class="body">
			<slot />
		</div>
	</div>
</section>

<style>
	.section {
		padding: 66px 0;
	}

	.heading {
		display: grid;
		gap: 8px;
		margin-bottom: 18px;
	}

	.title {
		margin: 0;
		font-size: 28px;
		letter-spacing: -0.5px;
	}

	.subtitle {
		margin: 0;
		font-size: 15px;
		max-width: 70ch;
	}

	@media (min-width: 860px) {
		.section {
			padding: 84px 0;
		}
		.title {
			font-size: 34px;
		}
	}
</style>

