---
import type { SimpleIcon } from "simple-icons";

type Props = {
	icon: SimpleIcon;
	label?: string;
};

const { icon, label } = Astro.props;
---

<span
	class="brandIcon"
	style={`--brand-color: #${icon.hex}`}
	aria-label={label}
	aria-hidden={label ? undefined : "true"}
	set:html={icon.svg}
/>

<style>
	.brandIcon {
		display: inline-flex;
		width: 1em;
		height: 1em;
		flex: 0 0 auto;
		color: var(--brand-color);
	}

	.brandIcon :global(svg) {
		width: 100%;
		height: 100%;
		fill: currentColor;
	}
</style>
