---
import type { Project } from "../data/projects";
import TechChip from "./TechChip.astro";
import SoldProductGallery from "./SoldProductGallery.astro";
import ProjectMedia from "./ProjectMedia.astro";
import { siGithub } from "simple-icons";
import BrandIcon from "./BrandIcon.astro";

type Props = {
	project: Project;
};

const { project } = Astro.props;
const { title, description, technologies, links, highlights } = project;
const dialogId = `${project.slug}-screenshots`;
const gallery = project.coverImage
	? [{ ...project.coverImage, caption: `Vista principal de ${title}` }]
	: [];
const primaryAction = links.demo ? 'demo' : links.repo ? 'repo' : links.caseStudy ? 'case-study' : null;
---

<article
	class="card project"
	data-reveal
	data-card-primary={primaryAction}
	tabindex={primaryAction ? '0' : undefined}
	role={primaryAction ? 'button' : undefined}
	aria-label={primaryAction ? `Abrir acción principal de ${title}` : undefined}
>
	{
		project.coverImage ? (
			<div class="cover">
				<ProjectMedia image={project.coverImage} dialogId={dialogId} />
			</div>
		) : null
	}
	<div class="top">
		<h3 class="title">{title}</h3>
		<p class="desc muted">{description}</p>
	</div>

	<div class="meta">
		<ul class="tech" aria-label="Tecnologías">
			{technologies.map((t) => (
				<TechChip label={t} />
			))}
		</ul>

		<div class="actions" aria-label="Enlaces del proyecto">
			{
				links.demo ? (
					<a
						class="button button-sm"
						data-card-primary="demo"
						href={links.demo}
						target="_blank"
						rel="noreferrer"
					>
						Ver
					</a>
				) : null
			}
			{
				links.repo ? (
					<a
						class="button button-sm"
						data-card-primary="repo"
						href={links.repo}
						target="_blank"
						rel="noreferrer"
					>
						<BrandIcon icon={siGithub} />
						Repositorio
					</a>
				) : null
			}
			{
				links.caseStudy ? (
					<a class="button button-sm" data-card-primary="case-study" href={links.caseStudy}>
						Detalle
					</a>
				) : null
			}
		</div>
	</div>

	{
		highlights?.length ? (
			<ul class="highlights" aria-label="Aspectos destacados">
				{highlights.slice(0, 3).map((h) => (
					<li>{h}</li>
				))}
			</ul>
		) : null
	}
</article>

{gallery.length ? <SoldProductGallery title={title} gallery={gallery} dialogId={dialogId} /> : null}

<style>
	.project {
		padding: 20px;
		display: grid;
		gap: 16px;
		transition:
			transform 180ms var(--ease),
			border-color 180ms var(--ease),
			background 180ms var(--ease);
	}

	.project:hover {
		transform: translateY(-2px);
		border-color: color-mix(in oklab, var(--accent) 40%, var(--border));
		background: linear-gradient(
			180deg,
			color-mix(in oklab, var(--surface) 70%, transparent),
			transparent
		);
	}

	.top {
		display: grid;
		gap: 8px;
	}

	.title {
		margin: 0;
		font-size: 18px;
		letter-spacing: -0.2px;
	}

	.desc {
		margin: 0;
		font-size: 14px;
	}

	.meta {
		display: grid;
		gap: 12px;
	}

	.tech {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 8px;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.actions {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 10px;
		align-items: center;
	}

	.button-sm {
		padding: 9px 11px;
		font-size: 13px;
	}

	.highlights {
		padding: 0;
		margin: 0;
		list-style: none;
		display: grid;
		gap: 8px;
		color: var(--muted);
		font-size: 14px;
	}

	.highlights li {
		display: flex;
		gap: 10px;
		align-items: flex-start;
	}

	.highlights li::before {
		content: "";
		width: 8px;
		height: 8px;
		margin-top: 6px;
		border-radius: 999px;
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		flex: 0 0 auto;
	}
</style>

<script>
	if (!document.documentElement.dataset.cardPrimaryActions) {
		document.documentElement.dataset.cardPrimaryActions = 'true';
		document.addEventListener('click', (event) => {
			const card = (event.target as Element).closest<HTMLElement>('[data-card-primary]');
			if (!card || (event.target as Element).closest('a, button, input, select, textarea, summary')) return;
			card.querySelector<HTMLElement>(`[data-card-primary="${card.dataset.cardPrimary}"]`)?.click();
		});
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			const card = event.target as HTMLElement;
			if (!card.matches('[data-card-primary]')) return;
			event.preventDefault();
			card.querySelector<HTMLElement>(`[data-card-primary="${card.dataset.cardPrimary}"]`)?.click();
		});
	}
</script>
