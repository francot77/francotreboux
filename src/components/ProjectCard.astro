---
import type { Project } from "../data/projects";
import TechChip from "./TechChip.astro";
import SoldProductGallery from "./SoldProductGallery.astro";
import ProjectMedia from "./ProjectMedia.astro";
import { siGithub } from "simple-icons";
import BrandIcon from "./BrandIcon.astro";
import { localizeProjects, type Locale } from '../i18n/localization';

type Props = {
	project: Project;
	locale?: Locale;
};

const { project, locale = 'es' } = Astro.props;
	const { title, technologies, links } = project;
		const localizedProject = localizeProjects(locale, [project])[0];
	const { description, highlights } = localizedProject;
const caseStudy = localizedProject.caseStudy;
const dialogId = `${project.slug}-screenshots`;
const caseStudyDialogId = `${project.slug}-case-study`;
const gallery = project.coverImage
	? [{ ...localizedProject.coverImage!, caption: locale === 'en' ? `Main view of ${title}` : `Vista principal de ${title}` }]
	: [];
const primaryAction = links.demo ? 'demo' : links.repo ? 'repo' : links.caseStudy ? 'case-study' : null;
---

<article
	class="card project"
	data-reveal
	data-card-primary={primaryAction}
	tabindex={primaryAction ? '0' : undefined}
	role={primaryAction ? 'button' : undefined}
	aria-label={primaryAction ? `${locale === 'en' ? 'Open primary action for' : 'Abrir acción principal de'} ${title}` : undefined}
>
	{
		project.coverImage ? (
			<div class="cover">
					<ProjectMedia image={localizedProject.coverImage!} locale={locale} dialogId={dialogId} />
			</div>
		) : null
	}
	<div class="top">
		<h3 class="title">{title}</h3>
		<p class="desc muted">{description}</p>
	</div>

	<div class="meta">
			<ul class="tech" aria-label={locale === 'en' ? 'Technologies' : 'Tecnologías'}>
			{technologies.map((t) => (
				<TechChip label={t} />
			))}
		</ul>

			<div class="actions" aria-label={locale === 'en' ? 'Project links' : 'Enlaces del proyecto'}>
			{
				links.demo ? (
					<a
						class="button button-sm"
						data-card-primary="demo"
						href={links.demo}
						target="_blank"
						rel="noreferrer"
					>
							{locale === 'en' ? 'View' : 'Ver'}
					</a>
				) : null
			}
			{
				links.repo ? (
					<a
						class="button button-sm"
						data-card-primary="repo"
						href={links.repo}
						target="_blank"
						rel="noreferrer"
					>
						<BrandIcon icon={siGithub} />
							{locale === 'en' ? 'Repository' : 'Repositorio'}
					</a>
				) : null
			}
			{
				links.caseStudy ? (
					<a class="button button-sm" data-card-primary="case-study" href={links.caseStudy}>
							{locale === 'en' ? 'Details' : 'Detalle'}
					</a>
				) : null
				}
				{caseStudy ? <button class="button button-sm" type="button" data-case-study-open={caseStudyDialogId} aria-controls={caseStudyDialogId} aria-haspopup="dialog">{locale === 'en' ? 'Case study' : 'Caso de estudio'}</button> : null}
			</div>
	</div>

	{
		highlights?.length ? (
				<ul class="highlights" aria-label={locale === 'en' ? 'Highlights' : 'Aspectos destacados'}>
				{highlights.slice(0, 3).map((h) => (
					<li>{h}</li>
				))}
			</ul>
		) : null
	}
</article>

	{gallery.length ? <SoldProductGallery title={title} gallery={gallery} locale={locale} dialogId={dialogId} /> : null}
	{caseStudy ? <dialog class="case-study-dialog" id={caseStudyDialogId} aria-labelledby={`${caseStudyDialogId}-title`} data-case-study-dialog>
		<div class="case-study-panel">
			<div class="case-study-header">
				<h2 id={`${caseStudyDialogId}-title`}>{title}: {locale === 'en' ? 'Case study' : 'Caso de estudio'}</h2>
				<button class="button close" type="button" data-case-study-close aria-label={locale === 'en' ? 'Close case study' : 'Cerrar caso de estudio'}><span aria-hidden="true">×</span></button>
			</div>
			<div class="case-study-content">
				{caseStudy.problem ? <section><h3>{locale === 'en' ? 'Problem' : 'Problema'}</h3><p>{caseStudy.problem}</p></section> : null}
				{caseStudy.context ? <section><h3>{locale === 'en' ? 'Context and constraints' : 'Contexto y restricciones'}</h3><p>{caseStudy.context}</p></section> : null}
				{caseStudy.architecture ? <section><h3>{locale === 'en' ? 'Architecture' : 'Arquitectura'}</h3><p>{caseStudy.architecture}</p></section> : null}
				{caseStudy.decisions?.length ? <section><h3>{locale === 'en' ? 'Key engineering decisions' : 'Decisiones clave de ingeniería'}</h3><ul>{caseStudy.decisions.map((item) => <li>{item}</li>)}</ul></section> : null}
				{caseStudy.challenges?.length ? <section><h3>{locale === 'en' ? 'Challenges' : 'Desafíos'}</h3><ul>{caseStudy.challenges.map((item) => <li>{item}</li>)}</ul></section> : null}
				{caseStudy.development ? <section><h3>{locale === 'en' ? 'Development approach' : 'Enfoque de desarrollo'}</h3><p>{caseStudy.development}</p></section> : null}
				{caseStudy.validation ? <section><h3>{locale === 'en' ? 'Validation and testing' : 'Validación y pruebas'}</h3><p>{caseStudy.validation}</p></section> : null}
				{caseStudy.outcome ? <section><h3>{locale === 'en' ? 'Outcome' : 'Resultado'}</h3><p>{caseStudy.outcome}</p></section> : null}
				{caseStudy.technologies?.length ? <section><h3>{locale === 'en' ? 'Technologies' : 'Tecnologías'}</h3><ul class="case-study-tech">{caseStudy.technologies.map((technology) => <li>{technology}</li>)}</ul></section> : null}
			</div>
		</div>
	</dialog> : null}

<style>
	.project {
		padding: 20px;
		display: grid;
		gap: 16px;
		transition:
			transform 180ms var(--ease),
			border-color 180ms var(--ease),
			background 180ms var(--ease);
	}

	.project:hover {
		transform: translateY(-2px);
		border-color: color-mix(in oklab, var(--accent) 40%, var(--border));
		background: linear-gradient(
			180deg,
			color-mix(in oklab, var(--surface) 70%, transparent),
			transparent
		);
	}

	.top {
		display: grid;
		gap: 8px;
	}

	.title {
		margin: 0;
		font-size: 18px;
		letter-spacing: -0.2px;
	}

	.desc {
		margin: 0;
		font-size: 14px;
	}

	.meta {
		display: grid;
		gap: 12px;
	}

	.tech {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 8px;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.actions {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 10px;
		align-items: center;
	}

	.button-sm {
		padding: 9px 11px;
		font-size: 13px;
	}

	.highlights {
		padding: 0;
		margin: 0;
		list-style: none;
		display: grid;
		gap: 8px;
		color: var(--muted);
		font-size: 14px;
	}

	.highlights li {
		display: flex;
		gap: 10px;
		align-items: flex-start;
	}

	.highlights li::before {
		content: "";
		width: 8px;
		height: 8px;
		margin-top: 6px;
		border-radius: 999px;
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		flex: 0 0 auto;
	}

	.case-study-dialog {
		box-sizing: border-box;
		width: min(720px, calc(100vw - 32px));
		max-height: calc(100vh - 32px);
		padding: 0;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg);
		color: var(--text);
		box-shadow: var(--shadow);
	}

	.case-study-dialog::backdrop { background: rgba(0, 0, 0, 0.68); }

	.case-study-panel { max-height: calc(100vh - 32px); overflow-y: auto; }

	.case-study-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 16px;
		padding: 20px 20px 0;
	}

	.case-study-header h2 { margin: 0; font-size: 20px; }

	.case-study-header .close { flex: 0 0 auto; width: 36px; height: 36px; padding: 0; font-size: 24px; line-height: 1; }

	.case-study-content {
		padding: 16px;
		font-size: 14px;
	}

	.case-study-content section + section { margin-top: 16px; }

	.case-study-content h3 {
		margin: 0 0 4px;
		font-size: 14px;
	}

	.case-study-content p,
	.case-study-content ul {
		margin: 0;
	}

	.case-study-content ul {
		display: grid;
		gap: 6px;
		padding-left: 20px;
	}

	.case-study-tech {
		grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
	}

	@media (max-width: 560px) {
		.case-study-dialog { width: calc(100vw - 16px); max-height: calc(100vh - 16px); }
		.case-study-panel { max-height: calc(100vh - 16px); }
		.case-study-header { padding: 16px 16px 0; }
	}
</style>

<script>
	if (!document.documentElement.dataset.cardPrimaryActions) {
		document.documentElement.dataset.cardPrimaryActions = 'true';
		document.addEventListener('click', (event) => {
			const card = (event.target as Element).closest<HTMLElement>('[data-card-primary]');
			if (!card || (event.target as Element).closest('a, button, input, select, textarea, summary')) return;
			card.querySelector<HTMLElement>(`[data-card-primary="${card.dataset.cardPrimary}"]`)?.click();
		});
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			const card = event.target as HTMLElement;
			if (!card.matches('[data-card-primary]')) return;
			event.preventDefault();
			card.querySelector<HTMLElement>(`[data-card-primary="${card.dataset.cardPrimary}"]`)?.click();
		});
	}

	if (!document.documentElement.dataset.caseStudyDialogs) {
		document.documentElement.dataset.caseStudyDialogs = 'true';
		for (const dialog of document.querySelectorAll<HTMLDialogElement>('[data-case-study-dialog]')) {
			const closeButton = dialog.querySelector<HTMLButtonElement>('[data-case-study-close]');
			let restoreFocusTo: HTMLElement | null = null;
			for (const openButton of document.querySelectorAll<HTMLButtonElement>(`[data-case-study-open="${dialog.id}"]`)) {
				openButton.addEventListener('click', () => { restoreFocusTo = openButton; dialog.showModal(); closeButton?.focus(); });
			}
			closeButton?.addEventListener('click', () => dialog.close());
			dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
			dialog.addEventListener('close', () => { restoreFocusTo?.focus(); restoreFocusTo = null; });
		}
	}
</script>
