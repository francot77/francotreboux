---
type MediaImage = {
	src: string;
	alt: string;
	width: number;
	height: number;
};
import type { Locale } from '../i18n/localization';

type Props = {
	image: MediaImage;
	dialogId?: string;
	label?: string;
	locale?: Locale;
};

const { image, dialogId, label, locale = 'es' } = Astro.props;
const imageLabel = label ?? (locale === 'en' ? `Enlarge image: ${image.alt}` : `Ampliar imagen: ${image.alt}`);
const isInteractive = Boolean(dialogId);
---

<div class="project-media" style={`aspect-ratio: ${image.width} / ${image.height}`}>
	{isInteractive ? (
		<button
			class="media-trigger"
			type="button"
			data-gallery-open
			aria-controls={dialogId}
			aria-haspopup="dialog"
			aria-label={imageLabel}
		>
			<img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
		</button>
	) : (
		<img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
	)}
</div>

<style>
	.project-media {
		width: 100%;
		overflow: hidden;
		background: var(--surface-2);
	}

	.project-media img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
	}

	.media-trigger {
		display: block;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: zoom-in;
	}
</style>
