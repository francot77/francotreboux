---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
import Section from "../components/Section.astro";
import { projects } from "../data/projects";
import ProjectCard from "../components/ProjectCard.astro";
import { experience } from "../data/experience";
import Timeline from "../components/Timeline.astro";
import { skillGroups } from "../data/skills";
import { certifications } from "../data/certifications";
import Badge from "../components/Badge.astro";
import TechChip from "../components/TechChip.astro";

export const prerender = true;
---

<BaseLayout
	title="Inicio"
	description={`${SITE.name}. Proyectos, experiencia, habilidades y certificaciones.`}
>
	<section class="hero">
		<div class="container inner">
			<div class="content" data-reveal>
				<p class="chip">
					<span class="dot" aria-hidden="true"></span>
					{SITE.location}
				</p>
				<h1 class="title">{SITE.name}</h1>
				<p class="lead muted">
					{SITE.role}. <br />Construyo productos web rápidos,
					accesibles y mantenibles.
				</p>
				<div class="cta">
					<a class="button" href="/proyectos">Ver proyectos</a>
					<a class="button secondary" href="/contacto">Contactar</a>
				</div>
				<div class="meta muted">
					<a
						href={SITE.social.linkedin}
						target="_blank"
						rel="noreferrer">LinkedIn</a
					>
					<span aria-hidden="true">·</span>
					<a
						href={SITE.social.github}
						target="_blank"
						rel="noreferrer">GitHub</a
					>
					<span aria-hidden="true">·</span>
					<a href={`mailto:${SITE.email}`}>{SITE.email}</a>
				</div>
			</div>

			<div class="" data-reveal>
				<div class="avatar" aria-hidden="true">
					<img src="/yopi.webp" alt="avatar" class="img-avatar" />
				</div>
			</div>
		</div>
	</section>

	<Section
		title="Proyectos"
		subtitle="Selección de trabajos recientes con enlaces a demo."
		id="proyectos"
	>
		<div class="grid projects">
			{
				projects
					.slice(0, 2)
					.map((project) => <ProjectCard project={project} />)
			}
		</div>
		<div class="more">
			<a class="button secondary" href="/proyectos">Ver todos</a>
		</div>
	</Section>

	<Section
		title="Experiencia"
		subtitle="Línea de tiempo cronológica de roles y responsabilidades."
		id="experiencia"
	>
		<Timeline items={experience} />
		<div class="more">
			<a class="button secondary" href="/experiencia">Detalle</a>
		</div>
	</Section>

	<Section
		title="Acerca de mí"
		subtitle="Resumen, habilidades técnicas y formas de trabajo."
		id="acerca"
	>
		<div class="about card" data-reveal>
			<div class="text">
				<p class="muted">
					Trabajo desarrollando productos web con foco en rendimiento,
					mantenibilidad y decisiones técnicas pragmáticas.
				</p>
				<p class="muted">
					Busco soluciones simples que puedan escalar sin volverse
					complejas innecesariamente
				</p>
			</div>
			<div class="skills">
				{
					skillGroups.map((g) => (
						<div class="group">
							<p class="groupTitle">{g.title}</p>
							<ul class="pillList">
								{g.items.map((i) => (
									<TechChip label={i} />
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
		<div class="more">
			<a class="button secondary" href="/acerca">Ver más</a>
		</div>
	</Section>

	<Section
		title="Educacion"
		subtitle="Cursos y certificaciones que respaldan formación y aprendizaje continuo."
		id="certificaciones"
	>
		<div class="grid certs">
			{
				certifications
					.slice(0, 4)
					.map((c) => (
						<Badge
							label={c.badgeLabel}
							title={c.name}
							subtitle={`${c.issuer} · ${c.year}`}
							href={c.url}
							imageSrc={c.image}
							imageAlt={c.imageAlt}
						/>
					))
			}
		</div>
		<div class="more">
			<a class="button secondary" href="/certificaciones">Ver todas</a>
		</div>
	</Section>

	<Section
		title="Contacto"
		subtitle="Envíame un mensaje o conecta en redes profesionales."
		id="contacto"
	>
		<div class="contact card" data-reveal>
			<div class="copy">
				<h3 class="h3">Hablemos</h3>
				<p class="muted">
					Disponible para proyectos freelance y oportunidades.
					Respondo normalmente en 24–48 horas.
				</p>
				<div class="links">
					<a
						class="button secondary"
						href={SITE.social.linkedin}
						target="_blank"
						rel="noreferrer"
					>
						LinkedIn
					</a>
					<a
						class="button secondary"
						href={SITE.social.github}
						target="_blank"
						rel="noreferrer"
					>
						GitHub
					</a>
					<a class="button" href="/contacto">Formulario</a>
				</div>
			</div>
			<div class="quick">
				<p class="chip">Email</p>
				<a class="email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
				<p class="chip">Ubicación</p>
				<p class="muted">{SITE.location}</p>
			</div>
		</div>
	</Section>
</BaseLayout>

<style>
	.hero {
		padding: 56px 0 14px;
	}

	.inner {
		display: grid;
		gap: 18px;
		align-items: start;
	}

	.dot {
		width: 8px;
		height: 8px;
		border-radius: 99px;
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
	}

	.content {
		display: grid;
		gap: 14px;
		padding: 20px 0;
	}

	.title {
		margin: 0;
		font-size: 44px;
		letter-spacing: -1.2px;
		line-height: 1.05;
	}

	.lead {
		margin: 0;
		font-size: 16px;
		max-width: 70ch;
	}

	.cta {
		display: inline-flex;
		gap: 10px;
		flex-wrap: wrap;
	}

	.secondary {
		background: transparent;
		box-shadow: none;
	}

	.meta {
		display: inline-flex;
		gap: 10px;
		flex-wrap: wrap;
		font-weight: 600;
		font-size: 14px;
	}

	.panel {
		padding: 18px;
		display: grid;
		gap: 12px;
	}
	.img-avatar {
		border-radius: 25%;
	}
	.avatar {
		width: 258px;
		height: 258px;
		display: grid;
		place-items: center;
		background: transparent;
	}

	.panelTitle {
		margin: 0;
		font-weight: 900;
		letter-spacing: -0.3px;
	}

	.bullets {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 10px;
		color: var(--muted);
		font-weight: 600;
	}

	.bullets li {
		display: flex;
		gap: 10px;
		align-items: flex-start;
	}

	.bullets li::before {
		content: "";
		width: 10px;
		height: 10px;
		margin-top: 6px;
		border-radius: 99px;
		background: var(--surface-2);
		border: 1px solid var(--border);
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.projects {
		grid-template-columns: 1fr;
	}

	.more {
		margin-top: 18px;
	}

	.about {
		padding: 18px;
		display: grid;
		gap: 18px;
	}

	.text {
		display: grid;
		gap: 10px;
	}

	.text p {
		margin: 0;
	}

	.skills {
		display: grid;
		gap: 14px;
	}

	.groupTitle {
		margin: 0 0 10px;
		font-weight: 900;
		letter-spacing: -0.2px;
	}

	.pillList {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.certs {
		grid-template-columns: 1fr;
	}

	.contact {
		padding: 18px;
		display: grid;
		gap: 18px;
	}

	.h3 {
		margin: 0;
		font-size: 18px;
		letter-spacing: -0.2px;
	}

	.copy {
		display: grid;
		gap: 12px;
	}

	.copy p {
		margin: 0;
	}

	.links {
		display: inline-flex;
		gap: 10px;
		flex-wrap: wrap;
	}

	.quick {
		display: grid;
		gap: 10px;
		align-content: start;
	}

	.email {
		font-weight: 800;
		letter-spacing: -0.2px;
	}

	@media (min-width: 940px) {
		.hero {
			padding: 76px 0 18px;
		}
		.inner {
			grid-template-columns: 1.25fr 0.75fr;
			align-items: center;
		}
		.title {
			font-size: 56px;
		}
		.projects {
			grid-template-columns: repeat(2, 1fr);
		}
		.certs {
			grid-template-columns: repeat(2, 1fr);
		}
		.about {
			grid-template-columns: 1fr 1fr;
			align-items: start;
		}
		.contact {
			grid-template-columns: 1.3fr 0.7fr;
			align-items: start;
		}
	}
</style>
