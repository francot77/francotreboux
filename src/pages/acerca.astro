---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import { skillGroups } from "../data/skills";
import TechChip from "../components/TechChip.astro";

export const prerender = true;
---

<BaseLayout
	title="Acerca de mí"
	description="Información personal, habilidades técnicas y enfoque de trabajo."
>
	<Section
		title="Acerca de mí"
		subtitle="Perfil profesional y habilidades técnicas."
		id="acerca"
	>
		<div class="card wrap" data-reveal>
			<div class="bio">
				<h3 class="h3">Perfil</h3>
				<p class="muted">
					Trabajo principalmente con TypeScript, React/Next.js y Node
				</p>
				<ul class="list" aria-label="Stack principal">
					<TechChip label="TypeScript" />
					<TechChip label="React" />
					<TechChip label="Next.js" />
					<TechChip label="Node.js" />
				</ul>
				<p class="muted">
					Desarrollo productos web con foco en rendimiento, claridad y
					arquitectura simple.
				</p>
				<p class="muted">
					Me interesa construir sistemas mantenibles, medir lo que
					importa y tomar decisiones técnicas con criterio.
				</p>
			</div>

			<div class="skills">
				<h3 class="h3">Habilidades</h3>
				{
					skillGroups.map((g) => (
						<div class="group">
							<p class="groupTitle">{g.title}</p>
							<ul class="list">
								{g.items.map((i) => (
									<TechChip label={i} />
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</Section>
</BaseLayout>

<style>
	.wrap {
		padding: 18px;
		display: grid;
		gap: 18px;
	}

	.h3 {
		margin: 0;
		font-size: 18px;
		letter-spacing: -0.2px;
	}

	.bio {
		display: grid;
		gap: 12px;
	}

	.bio p {
		margin: 0;
	}

	.skills {
		display: grid;
		gap: 14px;
	}

	.groupTitle {
		margin: 0 0 10px;
		font-weight: 900;
		letter-spacing: -0.2px;
	}

	.list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	@media (min-width: 940px) {
		.wrap {
			grid-template-columns: 1.2fr 0.8fr;
			align-items: start;
		}
	}
</style>
