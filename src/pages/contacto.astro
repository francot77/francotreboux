---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import ContactForm from "../components/ContactForm.astro";
import { SITE } from "../consts";

const sent = Astro.url.searchParams.get("enviado") === "1";
---

<BaseLayout
	title="Contacto"
	description="Formulario de contacto y enlaces a redes profesionales."
>
	<Section
		title="Contacto"
		subtitle="Escríbeme y conecta conmigo facilmente"
		id="contacto"
	>
		{
			sent ? (
				<div class="notice" role="status" data-reveal>
					<span class="noticeDot" aria-hidden="true" />
					<span>
						Mensaje recibido. ¡Gracias! Te responderé pronto.
					</span>
				</div>
			) : null
		}
		<div class="grid layout">
			<div class="card panel" data-reveal>
				<h3 class="h3">Envíame un mensaje</h3>
				<p class="muted">
					Cuéntame sobre tu proyecto o la oportunidad. Respondo
					normalmente en 24–48 horas.
				</p>
				<ContactForm subjectTag="portfolio" />
			</div>

			<aside class="card aside" data-reveal>
				<h3 class="h3">Enlaces</h3>
				<div class="links">
					<a
						class="button secondary"
						href={SITE.social.linkedin}
						target="_blank"
						rel="noreferrer"
					>
						LinkedIn
					</a>
					<a
						class="button secondary"
						href={SITE.social.github}
						target="_blank"
						rel="noreferrer"
					>
						GitHub
					</a>
					{
						SITE.social.x ? (
							<a
								class="button secondary"
								href={SITE.social.x}
								target="_blank"
								rel="noreferrer"
							>
								X
							</a>
						) : null
					}
					<a class="button" href={`mailto:${SITE.email}`}>Email</a>
				</div>
				<div class="meta">
					<p class="chip">Ubicación</p>
					<p class="muted">{SITE.location}</p>
				</div>
			</aside>
		</div>
	</Section>
</BaseLayout>

<style>
	.notice {
		display: inline-flex;
		gap: 10px;
		align-items: center;
		padding: 12px 14px;
		border-radius: 14px;
		border: 1px solid var(--border);
		background: color-mix(in oklab, var(--surface) 70%, transparent);
		margin-bottom: 14px;
	}

	.noticeDot {
		width: 10px;
		height: 10px;
		border-radius: 99px;
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
	}

	.layout {
		grid-template-columns: 1fr;
		align-items: start;
	}

	.panel,
	.aside {
		padding: 18px;
		display: grid;
		gap: 12px;
	}

	.h3 {
		margin: 0;
		font-size: 18px;
		letter-spacing: -0.2px;
	}

	p {
		margin: 0;
	}

	.secondary {
		background: transparent;
		box-shadow: none;
	}

	.links {
		display: grid;
		grid-template-columns: 1fr;
		gap: 10px;
	}

	.meta {
		margin-top: 10px;
		display: grid;
		gap: 10px;
	}

	@media (min-width: 940px) {
		.layout {
			grid-template-columns: 1.25fr 0.75fr;
		}
		.links {
			grid-template-columns: 1fr;
		}
	}
</style>
