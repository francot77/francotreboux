---
import { SITE } from '../consts';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
import type { Locale, PageId } from '../i18n/localization';
import { equivalentUrl, getCopy } from '../i18n/localization';

type Props = {
	title?: string;
	description?: string;
	canonicalPath?: string;
	locale?: Locale;
	pageId?: PageId;
};

const { title, description, canonicalPath, locale = 'es', pageId = 'home' } = Astro.props;
const localizedCopy = getCopy(locale);
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.role}`;
const pageDescription = description ?? localizedCopy.meta.description;
const baseUrl = Astro.site?.href ?? Astro.url.origin;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, baseUrl).toString();
const alternateEs = new URL(equivalentUrl(pageId, 'es'), baseUrl).toString();
const alternateEn = new URL(equivalentUrl(pageId, 'en'), baseUrl).toString();
---

<!doctype html>
	<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="index,follow" />
		<meta name="description" content={pageDescription} />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0c10" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
			<link rel="canonical" href={canonicalUrl} />
			<link rel="alternate" hreflang="es" href={alternateEs} />
			<link rel="alternate" hreflang="en" href={alternateEn} />
			<link rel="alternate" hreflang="x-default" href={alternateEs} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{pageTitle}</title>

		<meta property="og:type" content="website" />
			<meta property="og:locale" content={localizedCopy.meta.locale} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={SITE.name} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />

		<meta name="generator" content={Astro.generator} />
		<script type="application/ld+json" is:inline>
			{JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'Person',
				name: SITE.name,
				jobTitle: SITE.role,
				url: baseUrl,
				email: SITE.email ? `mailto:${SITE.email}` : undefined,
				sameAs: Object.values(SITE.social).filter(Boolean),
			})}
		</script>

		<script is:inline>
			(() => {
				const storageKey = 'theme';
				const saved = localStorage.getItem(storageKey);
				const prefersLight = window.matchMedia?.('(prefers-color-scheme: light)').matches;
				const theme = saved === 'light' || saved === 'dark' ? saved : prefersLight ? 'light' : 'dark';
				document.documentElement.dataset.theme = theme;
			})();
		</script>
	</head>
	<body>
			<a class="sr-only" href="#contenido">{locale === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a>
			<Header locale={locale} pageId={pageId} />
		<main id="contenido">
			<slot />
		</main>
			<Footer locale={locale} />
		<script is:inline>
			// A native modal dialog makes the page inert but does not stop it
			// scrolling behind the backdrop. Lock the page while any dialog is
			// open, in one place, so the header menu, the case studies and the
			// image gallery cannot drift apart.
			(() => {
				const root = document.documentElement;
				let lockedScrollY = 0;

				const anyDialogOpen = () => document.querySelector('dialog[open]') !== null;

				const lock = () => {
					if (root.hasAttribute('data-dialog-open')) return;
					// Hiding the scrollbar reclaims its width and shifts the layout,
					// so give it back as padding.
					const scrollbar = window.innerWidth - root.clientWidth;
					lockedScrollY = window.scrollY;
					root.style.setProperty('--scrollbar-width', scrollbar + 'px');
					root.setAttribute('data-dialog-open', '');
					// iOS ignores overflow:hidden on the root, so the body is also
					// pinned in place and restored to the same offset on close.
					document.body.style.top = -lockedScrollY + 'px';
				};

				const unlock = () => {
					if (!root.hasAttribute('data-dialog-open')) return;
					root.removeAttribute('data-dialog-open');
					document.body.style.top = '';
					window.scrollTo(0, lockedScrollY);
				};

				const sync = () => (anyDialogOpen() ? lock() : unlock());

				// Watching the open attribute covers every path that closes a
				// dialog, including Escape and form submission, which do not go
				// through any click handler.
				const observer = new MutationObserver(sync);
				const watch = (dialog) => observer.observe(dialog, { attributes: true, attributeFilter: ['open'] });
				for (const dialog of document.querySelectorAll('dialog')) watch(dialog);
				new MutationObserver((records) => {
					for (const record of records) {
						for (const node of record.addedNodes) {
							if (node.nodeType !== 1) continue;
							if (node.tagName === 'DIALOG') watch(node);
							else node.querySelectorAll?.('dialog').forEach(watch);
						}
					}
					sync();
				}).observe(document.body, { childList: true, subtree: true });

				sync();
			})();
		</script>
		<script is:inline>
			(() => {
				const targets = Array.from(document.querySelectorAll('[data-reveal]'));
				if (targets.length === 0) return;
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							const el = entry.target;
							el.setAttribute('data-reveal-visible', 'true');
							observer.unobserve(el);
						}
					},
					{ rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
				);
				for (const el of targets) observer.observe(el);
			})();
		</script>
	</body>
</html>

<style>
	body {
		padding-top: var(--header-h);
	}

	main {
		min-height: calc(100vh - var(--header-h));
	}
</style>

